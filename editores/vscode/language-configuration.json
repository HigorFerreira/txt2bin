{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"], ["${", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "${", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""]],
  "wordPattern": "(\\$[A-Za-z_][\\w.]*)|(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
  "folding": { "markers": { "start": "^<<", "end": "(?=^<<)" } }
}
