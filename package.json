{
  "name": "txt2bin",
  "version": "0.4.0",
  "description": "Write binary files as plain text: hex, text, base64, numbers in any byte order, self-computing labels and inline assembly for 30+ architectures",
  "license": "MIT",
  "author": "Higor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HigorFerreira/txt2bin.git"
  },
  "homepage": "https://github.com/HigorFerreira/txt2bin#readme",
  "bugs": {
    "url": "https://github.com/HigorFerreira/txt2bin/issues"
  },
  "type": "module",
  "bin": {
    "txt2bin": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "compile": "bun build src/cli.ts --compile --outfile=dist/txt2bin",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "bun-types": "^1.4.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "binary",
    "hex",
    "assembler",
    "llvm",
    "gltf",
    "file-format",
    "bytes",
    "plain-text",
    "binary-format",
    "midi",
    "boot-sector",
    "intel-hex",
    "ttb"
  ]
}
